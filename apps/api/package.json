{
  "name": "@gradual/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "create-admin": "tsx --env-file=.env src/scripts/create-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@gradual/shared": "0.1.0",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "sanitize-html": "^2.18.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
