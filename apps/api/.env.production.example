# Production values for apps/api/.env on the EC2 instance (D55). Copy to .env and fill in.
# NODE_ENV, PORT and HOST are set by ecosystem.config.cjs (api listens on 127.0.0.1:4110)
APP_BASE_URL=https://gradual.example.com
DEFAULT_TENANT_SLUG=gradual

DB_HOST=<rds-endpoint>
DB_PORT=3306
DB_USER=gradual
DB_PASSWORD=
DB_NAME=a360MoodleManual

SESSION_DAYS=30
# HTTPS only in production
COOKIE_SECURE=true

AWS_REGION=us-east-2
# Same bucket as development: dev and prod share the gradual_* tables, so files must be shared too
S3_BUCKET=gradual-dev
# No AWS keys here: the SDK uses the EC2 instance role (attach gradual-app-policy to it).

MAIL_TRANSPORT=ses
MAIL_FROM=Gradual <no-reply@genia.pro>

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDERS=anthropic,openai,gemini
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
LLM_PRICING={}
# Ignored in production anyway; keep false
LLM_STUB=false
