# --- Server ---
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in email links). Temporary until the final domain is set (D31).
APP_BASE_URL=http://localhost:3000
# Default tenant when the Host header does not match any tenant domain (development / single tenant).
DEFAULT_TENANT_SLUG=gradual

# --- Database (shared RDS; every table uses the gradual_ prefix, D33/D34) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gradual
DB_PASSWORD=
DB_NAME=a360MoodleManual

# --- Session ---
SESSION_DAYS=30
COOKIE_SECURE=false

# --- AWS ---
AWS_REGION=us-east-1
S3_BUCKET=gradual-dev
# Optional in development (MinIO): S3_ENDPOINT=http://localhost:9000
# console = print emails to the log; ses = send through Amazon SES
MAIL_TRANSPORT=console
# Temporary sender on a domain already verified in SES (D31)
MAIL_FROM=Gradual <no-reply@example.com>

# --- LLM for the CV improver (D44): keys dedicated to Gradual ---
# A provider is only used when its key is set. Order = rotation/failover order.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDERS=anthropic,openai,gemini
# Check these model IDs against each provider's current model list
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
# Optional: USD per million tokens, to record cost per run. Example: {"claude-sonnet-5-5":[3,15]}
LLM_PRICING={}
# Development only: true = canned sample result, no LLM calls or cost (ignored in production)
LLM_STUB=false
